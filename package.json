{
  "name": "qc-server-backend",
  "version": "2.1.0",
  "description": "QuantumConnect Dedicated Real-Time Server Backend — Messaging, WebRTC Signaling & Persistent Storage",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --check server.js && node --check database.js",
    "healthcheck": "node -e \"fetch('http://localhost:' + (process.env.PORT || 4000) + '/api/health').then(r => r.ok ? process.exit(0) : process.exit(1)).catch(() => process.exit(1))\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.8.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "quantumconnect",
    "webrtc",
    "socketio",
    "real-time",
    "messaging",
    "calling",
    "chat-backend"
  ],
  "author": "QuantumConnect Team",
  "license": "MIT"
}
