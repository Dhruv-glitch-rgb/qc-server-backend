# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Database runtime JSON files (clean slate on deployment)
data/*.json
data/**/*.tmp
data/**/*.bak
data/users/*
!data/users/.gitkeep
!data/.gitkeep

# Uploads and user media (large binaries should not be committed to GitHub)
uploads/*
!uploads/.gitkeep

# OS generated files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Logs
logs/
*.log
